{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ohjelma",
  "type": "object",
  "required": ["versio", "id", "nimi", "paivat"],
  "additionalProperties": false,
  "properties": {
    "versio": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "nimi": { "type": "string", "minLength": 1 },
    "paikka": { "type": "string" },
    "joukkue": { "type": "string" },
    "lahde": {
      "type": "object",
      "required": ["tyyppi"],
      "additionalProperties": false,
      "properties": {
        "tyyppi": { "enum": ["kasin", "json", "tulospalvelu"] },
        "huom": { "type": "string" }
      }
    },
    "paivat": { "type": "array", "items": { "$ref": "#/$defs/paiva" } }
  },
  "$defs": {
    "aika": { "type": "string", "pattern": "^([01][0-9]|2[0-3])\\.[0-5][0-9]$" },
    "paiva": {
      "type": "object",
      "required": ["pvm", "osiot"],
      "additionalProperties": false,
      "properties": {
        "pvm": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "herays": { "$ref": "#/$defs/aika" },
        "osiot": { "type": "array", "items": { "$ref": "#/$defs/osio" } }
      }
    },
    "osio": {
      "type": "object",
      "required": ["id", "tyyppi", "alku", "kesto", "nimi"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tyyppi": { "enum": ["peli", "harjoitus", "testi", "ateria"] },
        "alku": { "$ref": "#/$defs/aika" },
        "kesto": { "type": ["integer", "null"], "minimum": 1 },
        "nimi": { "type": "string", "minLength": 1 },
        "huom": { "type": "string" },
        "ateria": { "enum": ["aamiainen", "lounas", "paivallinen", "iltapala", "valipala"] },
        "pelimuoto": { "type": "string" },
        "jaksot": {
          "type": "object",
          "required": ["maara", "pituus"],
          "additionalProperties": false,
          "properties": {
            "maara": { "type": "integer", "minimum": 1 },
            "pituus": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "tyyppi": { "const": "ateria" } } }, "then": { "required": ["ateria"] }, "else": { "not": { "required": ["ateria"] } } },
        { "if": { "properties": { "tyyppi": { "const": "peli" } } }, "then": { "properties": { "kesto": { "type": "integer" } } } }
      ]
    }
  }
}
